# ==============================================================
# CONFIGURACIÓN DEL SERVIDOR REMOTO Y COPIA DE SEGURIDAD
# Copia este archivo como ".env" en esta misma carpeta y rellena tus datos reales:
#   cp .env.example .env
# ==============================================================

# IP o nombre de host del servidor
SERVER_IP=192.168.1.100

# Puerto SSH (por defecto 22)
SERVER_PORT=22

# Usuario del servidor (si no es root, asegúrate de tener USE_SUDO=true)
SERVER_USER=tu_usuario

# Contraseña SSH (y contraseña de sudo si USE_SUDO=true)
SERVER_PASSWORD=tu_contraseña_aqui

# --------------------------------------------------------------
# RUTAS DE ORIGEN Y DESTINO EN EL SERVIDOR
# --------------------------------------------------------------
# Ruta del disco duro externo o carpeta que quieres respaldar (ORIGEN)
SOURCE_DIR=/media/daevon/TuDiscoExterno

# Carpeta en el disco interno del servidor donde se guardará el backup (DESTINO)
BACKUP_DIR=/home/tu_usuario/backups

# Nombre del archivo de backup resultante
BACKUP_FILENAME=backup_disco_externo.tar.gz

# --------------------------------------------------------------
# OPCIONES ADICIONALES
# --------------------------------------------------------------
# ¿Ejecutar comandos con sudo? (Recomendado 'true' si tu usuario no es root o el disco externo requiere permisos)
USE_SUDO=true

# Intentar instalar 'pv' (Pipe Viewer) en el servidor si no está instalado para mostrar progreso exacto y ETA
AUTO_INSTALL_PV=true
